# Raspi Ruxpin Environment Configuration
# Copy this file to .env and adjust values as needed.
# See .env.example.mac and .env.example.pi for platform-specific examples.

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8888

# Serial / Arduino Connection
# Auto-detected on macOS (uses mock serial)
# SERIAL__PORT=/dev/ttyUSB0
# SERIAL__BAUD_RATE=115200
# SERIAL__USE_MOCK=false

# Sync Mode: amplitude, phoneme, or realtime
SYNC__MODE=amplitude
# Servo type: hbridge (original 5-wire) or standard (3-wire hobby)
SYNC__SERVO_TYPE=hbridge

# Audio
AUDIO__START_VOLUME=80
AUDIO__SOUNDS_DIR=data/sounds
# AUDIO__DEVICE=plughw:1,0    # ALSA device (Linux only, optional)
# AUDIO__CARD_INDEX=1          # ALSA card index (Linux only, optional)
# AUDIO__MIXER=PCM             # ALSA mixer name (Linux only)

# Text-to-Speech
TTS__ENGINE=espeak
TTS__VOICE=en-us+m7
TTS__SPEED=140
TTS__PITCH=40
TTS__OUTPUT_DIR=data/tts
