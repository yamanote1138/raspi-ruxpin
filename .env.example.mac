# Raspi Ruxpin — macOS Development
# Copy to .env for local development without hardware.
#
# Mock serial auto-detected on macOS. Audio plays via afplay.
# Volume controlled via AppleScript (system volume).

ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8888

# Serial: mock is auto-detected on macOS, no config needed
# SERIAL__USE_MOCK=true

# Sync
SYNC__MODE=amplitude
SYNC__SERVO_TYPE=hbridge

# Audio (Mac uses system audio, no ALSA config needed)
AUDIO__START_VOLUME=50
AUDIO__SOUNDS_DIR=data/sounds

# TTS (uses macOS 'say' command when engine is espeak)
TTS__ENGINE=espeak
TTS__VOICE=en-us+m7
TTS__SPEED=140
TTS__PITCH=40
TTS__OUTPUT_DIR=data/tts
