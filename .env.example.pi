# Raspi Ruxpin — Raspberry Pi Production
# Copy to .env on your Pi.
#
# Arduino connected via USB serial. Audio via ALSA.
# Volume capped at 90% to prevent system instability.

ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8888

# Serial: Arduino connected via USB
SERIAL__PORT=/dev/ttyUSB0
SERIAL__BAUD_RATE=115200
SERIAL__USE_MOCK=false

# Sync
SYNC__MODE=amplitude
SYNC__SERVO_TYPE=hbridge

# Audio (ALSA)
# Find devices: aplay -l | Find mixers: amixer scontrols
AUDIO__MIXER=PCM
AUDIO__START_VOLUME=90
AUDIO__SOUNDS_DIR=data/sounds
# AUDIO__DEVICE=plughw:1,0
# AUDIO__CARD_INDEX=1

# TTS
# Install: sudo apt install espeak-ng
TTS__ENGINE=espeak
TTS__VOICE=en-us+m7
TTS__SPEED=140
TTS__PITCH=40
TTS__OUTPUT_DIR=data/tts
